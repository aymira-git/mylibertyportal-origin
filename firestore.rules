rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function hasRole(role) {
      return signedIn() && userProfile().role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isManager() {
      return hasRole('manager');
    }

    function isStaff() {
      return signedIn() && userProfile().role in ['admin', 'manager', 'instructor', 'instructorleader', 'instructor_leader', 'marketing', 'frontoffice', 'opslead', 'ops_lead', 'frontofficelead', 'officeboy'];
    }

    function isFrontOffice() {
      return signedIn() && userProfile().role in ['frontoffice', 'opslead', 'ops_lead', 'frontofficelead'];
    }

    function userBranch() {
      return signedIn() && ('branchId' in userProfile())
        ? userProfile().branchId
        : 'kota_gorontalo';
    }

    function isSameBranch(data) {
      return isAdmin() || (signedIn() && (
        (data != null && 'branchId' in data && data.branchId == userBranch()) ||
        (data != null && !('branchId' in data) && 'branch' in data && (
          (data.branch == 'Bone Bolango' && userBranch() == 'bone_bolango') ||
          (data.branch == 'Pohuwato' && userBranch() == 'pohuwato') ||
          (data.branch == 'Limboto' && userBranch() == 'limboto') ||
          (data.branch == 'Cabang Utama' && userBranch() == 'kota_gorontalo') ||
          (data.branch == 'Kota Gorontalo' && userBranch() == 'kota_gorontalo')
        )) ||
        (data != null && !('branchId' in data) && !('branch' in data) && userBranch() == 'kota_gorontalo')
      ));
    }

    // For `list` only: isSameBranch's no-branch-fields -> kota_gorontalo fallback
    // is unsound there. List rules are evaluated against a synthetic document
    // built from the query's where clauses, so a query with no branch filter
    // produces a fieldless synthetic doc that the fallback treats as Kota
    // Gorontalo — letting Kota Gorontalo staff list every branch's documents.
    // get/update/delete keep the lenient form so legacy branchless docs stay
    // readable/writable to Kota Gorontalo staff.
    function isSameBranchStrict(data) {
      return (data != null && 'branchId' in data && data.branchId == userBranch())
        || (data != null && !('branchId' in data) && 'branch' in data && (
          (data.branch == 'Bone Bolango' && userBranch() == 'bone_bolango') ||
          (data.branch == 'Pohuwato' && userBranch() == 'pohuwato') ||
          (data.branch == 'Limboto' && userBranch() == 'limboto') ||
          (data.branch == 'Cabang Utama' && userBranch() == 'kota_gorontalo') ||
          (data.branch == 'Kota Gorontalo' && userBranch() == 'kota_gorontalo')
        ));
    }

    function isApproverForDoc(data) {
      let targetRole = data != null && 'approverRole' in data ? data.approverRole : 'manager';
      let roleMatches = (targetRole == 'admin' && isAdmin())
        || (targetRole == 'manager' && isManager())
        || ((targetRole == 'instructor_leader' || targetRole == 'instructorleader') && (hasRole('instructorleader') || hasRole('instructor_leader')))
        || ((targetRole == 'ops_lead' || targetRole == 'opslead' || targetRole == 'frontoffice') && isFrontOffice());
      // Approval docs route by approverBranchId (see approvalGates.js); fall back
      // to the generic branch fields for legacy docs.
      let branchMatches = isAdmin() || (data != null && 'approverBranchId' in data
        ? data.approverBranchId == userBranch()
        : isSameBranch(data));
      return roleMatches && branchMatches;
    }

    function roleOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function isTrackedShiftRole(r) {
      return r in ['instructor', 'instructorleader', 'instructor_leader', 'frontoffice', 'opslead', 'ops_lead', 'frontofficelead', 'marketing', 'officeboy', 'admin', 'manager'];
    }

    function isTrackedLeaveRole(r) {
      return r in ['instructor', 'instructorleader', 'instructor_leader', 'frontoffice', 'opslead', 'ops_lead', 'frontofficelead', 'marketing', 'officeboy', 'admin'];
    }

    function isInviteValid(inviteId) {
      let inv = get(/databases/$(database)/documents/invites/$(inviteId)).data;
      return inv.email == request.auth.token.email.lower()
          && inv.role == request.resource.data.role
          && (!('expiresAt' in inv) || inv.expiresAt > request.time.toMillis())
          && (!('branchId' in inv) || request.resource.data.branchId == inv.branchId)
          && (!('division' in inv) || request.resource.data.division == inv.division);
    }

    function isApprovedShiftCorrection(shiftId, approvalId) {
      let approval = get(/databases/$(database)/documents/approvals/$(approvalId)).data;
      return approval.actionId == 'STAFF_SHIFT_SELF_CORRECTION'
        && approval.status == 'approved'
        && 'payload' in approval
        && approval.payload != null
        && approval.payload.shiftId == shiftId;
    }

    match /users/{userId} {
      allow get: if resource.data.role == 'student'
        || isAdmin()
        || (isManager() && isSameBranch(resource.data))
        || (isStaff() && resource.data.role in ['student', 'instructor', 'instructorleader', 'instructor_leader'] && isSameBranch(resource.data))
        || (signedIn() && userId == request.auth.uid);
      allow list: if isAdmin()
        || (isManager() && isSameBranch(resource.data))
        || (isStaff() && resource.data.role in ['student', 'instructor', 'instructorleader', 'instructor_leader'] && isSameBranch(resource.data));
      allow create: if isAdmin() 
        || (isFrontOffice() && request.resource.data.role == 'student' && isSameBranch(request.resource.data))
        || (signedIn()
            && userId == request.auth.uid
            && request.resource.data.inviteId is string
            && isInviteValid(request.resource.data.inviteId));
      allow delete: if isAdmin() || (isFrontOffice() && resource.data.role == 'student' && isSameBranch(resource.data));
      allow update: if isAdmin()
        || (isFrontOffice()
          && resource.data.role == 'student'
          && request.resource.data.role == 'student'
          && isSameBranch(resource.data)
          && isSameBranch(request.resource.data)
          && (!('branchId' in resource.data) || request.resource.data.branchId == resource.data.branchId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'displayName', 'name', 'phone', 'dob', 'address', 'parentName', 'parentPhone',
              'emergencyContact', 'emergencyPhone', 'notes', 'placementTests', 'status',
              'statusUpdatedAt', 'statusUpdatedBy',
              'level', 'currentLevel', 'enrollmentDate',
              'updatedAt', 'photoURL', 'nickname', 'gender', 'nis', 'school', 'grade',
              'placeOfBirth', 'religion', 'programId', 'program', 'batchType', 'classType',
              'schoolOrJob', 'classOrSemester', 'joinedDate', 'fatherName', 'fatherJob',
              'fatherPhone', 'motherName', 'motherJob', 'motherPhone', 'referralSource',
              'rating', 'paymentPlan', 'paymentStatus', 'lastPaymentPeriod', 'lastPaymentDate',
              'lastPaymentAmount', 'lastPaymentMethod', 'paidUntil', 'branch'
            ]))
        || (signedIn()
          && userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'phone', 'dob', 'photoURL', 'nickname']));
    }

    match /invites/{inviteId} {
      // inviteId is the invite's unguessable token. Public signup can look
      // an invite up by its exact ID, but can never list/dump the collection.
      allow get: if true;
      allow list: if isAdmin() || isFrontOffice();

      // A newly-registered staff member may clear the one invite that
      // matches their own (just-verified) auth email; admins can cancel any.
      allow delete: if isAdmin()
        || (signedIn() && resource.data.email == request.auth.token.email);

      allow create: if isAdmin();
    }

    match /applications/{applicationId} {
      // Branch-isolated admissions
      allow read: if isAdmin() || ((isFrontOffice() || isManager() || hasRole('marketing')) && isSameBranch(resource.data));
      allow update: if isAdmin() || (isFrontOffice() && isSameBranch(resource.data) && isSameBranch(request.resource.data) && (!('branchId' in resource.data) || request.resource.data.branchId == resource.data.branchId));
      allow delete: if isAdmin() || (isFrontOffice() && isSameBranch(resource.data));
      allow create: if false;
    }

    match /classes/{classId} {
      allow read: if isStaff()
        || (signedIn() && resource.data.studentIds.hasAny([request.auth.uid]));
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isFrontOffice()
          && isSameBranch(resource.data)
          && isSameBranch(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentIds', 'enrollments', 'updatedAt']));
    }

    match /todos/{todoId} {
      // All active staff can read directives to receive their assignments
      allow read: if isStaff();
      // Admins and Managers issue directives; Front Office can manage desk directives
      allow create, delete: if isAdmin() || isManager() || isFrontOffice();
      // Admins, Managers, and Front Office can update any directive field;
      // other staff can only toggle completion status and attribution
      allow update: if isAdmin() || isManager() || isFrontOffice()
        || (isStaff() && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['completed', 'completedAt', 'completedBy', 'completedByName', 'updatedAt']));
    }

    match /attendance/{attendanceId} {
      allow read: if isStaff();
      // Student scans: Admin (reception station), Front Office, Instructor, and Instructor Leader; scanned person must be a student
      allow create: if (isAdmin() || isFrontOffice() || hasRole('instructor') || hasRole('instructorleader') || hasRole('instructor_leader'))
        && request.resource.data.userId is string
        && request.resource.data.timestamp is string
        && roleOf(request.resource.data.userId) == 'student';
      // Double-scan idempotency: allow Front Office and Instructors to update existing day scan as long as student identity is preserved
      allow update: if isAdmin()
        || ((isFrontOffice() || hasRole('instructor') || hasRole('instructorleader') || hasRole('instructor_leader'))
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow get: if isAdmin() || ((isManager() || isFrontOffice()) && isSameBranch(resource.data)) || (signedIn() && resource.data.studentId == request.auth.uid);
      allow list: if isAdmin() || ((isManager() || isFrontOffice()) && isSameBranchStrict(resource.data));
      allow create: if isAdmin() || (isFrontOffice() && isSameBranch(request.resource.data));
      allow update: if isAdmin() || (isFrontOffice() && isSameBranch(resource.data) && isSameBranch(request.resource.data) && (!('branchId' in resource.data) || request.resource.data.branchId == resource.data.branchId));
      allow delete: if isAdmin() || (isFrontOffice() && isSameBranch(resource.data));
    }

    match /deskInquiries/{inquiryId} {
      allow read: if isAdmin() || ((isManager() || isFrontOffice() || isStaff()) && isSameBranch(resource.data));
      allow create: if isAdmin() || ((isManager() || isFrontOffice() || isStaff()) && isSameBranch(request.resource.data));
      allow update: if isAdmin() || ((isManager() || isFrontOffice() || isStaff()) && isSameBranch(resource.data) && isSameBranch(request.resource.data) && (!('branchId' in resource.data) || request.resource.data.branchId == resource.data.branchId));
      allow delete: if isAdmin() || ((isManager() || isFrontOffice()) && isSameBranch(resource.data));
    }

    match /approvals/{approvalId} {
      allow read: if isAdmin()
        || isApproverForDoc(resource.data)
        || (signedIn() && resource.data.requestedByUid == request.auth.uid);
      allow create: if isStaff()
        && request.resource.data.requestedByUid == request.auth.uid
        && (!('status' in request.resource.data) || request.resource.data.status == 'pending');
      allow update: if isAdmin()
        || (isApproverForDoc(resource.data)
          && request.auth.uid != resource.data.requestedByUid
          && request.resource.data.requestedByUid == resource.data.requestedByUid
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.decidedByUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'decidedBy', 'decidedByUid', 'decidedAt', 'decisionNotes', 'rejectionReason', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /progressReports/{reportId} {
      allow read: if isAdmin()
        || isManager()
        || isFrontOffice()
        || (signedIn() && resource.data.instructorId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.instructorId == request.auth.uid
        && request.resource.data.studentId is string
        && request.resource.data.classId is string
        && get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.instructorId == request.auth.uid
        && get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.studentIds.hasAny([request.resource.data.studentId]);
      allow update, delete: if isAdmin() || isFrontOffice();
    }

    match /shifts/{shiftId} {
      allow read: if isAdmin()
        || (isManager() && isSameBranch(resource.data))
        || (signedIn() && resource.data.userId == request.auth.uid);
      // Staff scans: Admin and Front Office (reception kiosk station), for tracked roles only, new shifts start open
      allow create: if (isAdmin() || (isFrontOffice() && isSameBranch(request.resource.data)))
        && request.resource.data.userId is string
        && request.resource.data.clockOut == null
        && isTrackedShiftRole(roleOf(request.resource.data.userId));
      // Shift clock-out and updates: Admin or Front Office (kiosk clock-out)
      allow update: if isAdmin()
        || (isFrontOffice()
          && isSameBranch(resource.data)
          && resource.data.clockOut == null
          && request.resource.data.clockOut is string
          && request.resource.data.userId == resource.data.userId
          && (!('branch' in resource.data) || request.resource.data.branch == resource.data.branch)
          && (!('branchId' in resource.data) || request.resource.data.branchId == resource.data.branchId)
          && request.resource.data.clockIn == resource.data.clockIn
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['clockOut', 'updatedAt', 'cashReconciliation', 'notes', 'status', 'verifiedBy', 'verifiedAt', 'autoClosed']))
        // Approved shift self-corrections: Front Office / Manager may only apply a correction
        // already approved via the maker-checker approvals collection (dual-control enforced by rules).
        || ((isFrontOffice() || isManager())
          && isSameBranch(resource.data)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.appliedFromApproval is string
          && isApprovedShiftCorrection(shiftId, request.resource.data.appliedFromApproval)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['clockIn', 'clockOut', 'corrected', 'reviewStatus', 'appliedFromApproval']));
      allow delete: if isAdmin();
    }

    match /shiftAuditEvents/{eventId} {
      allow read: if isAdmin() || isManager();
      allow create: if (isAdmin()
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.shiftId is string)
        || ((isFrontOffice() || isManager())
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.shiftId is string
          && request.resource.data.action == 'manual_adjustment'
          && request.resource.data.appliedFromApproval is string
          && isApprovedShiftCorrection(request.resource.data.shiftId, request.resource.data.appliedFromApproval));
      allow update, delete: if false; // append-only immutable audit trail
    }

    match /corporateEvents/{eventId} {
      allow read: if isStaff();
      allow create: if (isAdmin() || isFrontOffice())
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.name is string
        && request.resource.data.eventDate is string
        && request.resource.data.audienceType in ['all', 'branch', 'role', 'division'];
      allow update: if (isAdmin() || isFrontOffice())
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false; // soft-cancel only
    }

    match /staffLeave/{leaveId} {
      allow read: if isAdmin()
        || isManager()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.status == 'approved'
        && isTrackedLeaveRole(roleOf(request.resource.data.userId));
      allow update, delete: if isAdmin();
    }

    match /materials/{materialId} {
      allow read: if signedIn()
        && resource.data.createdBy == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.createdBy == request.auth.uid;
    }

    match /errorLogs/{logId} {
      allow create: if signedIn()
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000
        && request.resource.data.timestamp is string
        && (!('stack' in request.resource.data) || (request.resource.data.stack is string && request.resource.data.stack.size() <= 8000))
        && (!('url' in request.resource.data) || (request.resource.data.url is string && request.resource.data.url.size() <= 1000));
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /schoolOutreach/{schoolId} {
      // Read access is restricted to roles that have an operational need:
      // Admin (full access), Manager (oversight/reporting), Marketing (field work).
      // Instructor, Front Office, and Office Boy have no outreach business and are excluded.
      allow read: if isAdmin() || ((isManager() || hasRole('marketing')) && isSameBranch(resource.data));
      allow create: if (isAdmin() || ((isManager() || hasRole('marketing')) && isSameBranch(request.resource.data)))
        && request.resource.data.name is string
        && request.resource.data.lat is number
        && request.resource.data.lng is number;
      allow update: if (isAdmin() || ((isManager() || hasRole('marketing')) && isSameBranch(resource.data) && isSameBranch(request.resource.data)))
        && (!('createdBy' in resource.data) || request.resource.data.createdBy == resource.data.createdBy)
        && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if isAdmin();

      match /visits/{visitId} {
        // Enforce branch check against parent school document so visits are isolated per branch
        allow read: if isAdmin()
          || ((isManager() || hasRole('marketing'))
            && isSameBranch(get(/databases/$(database)/documents/schoolOutreach/$(schoolId)).data));
        allow create: if (isAdmin() || ((isManager() || hasRole('marketing'))
            && isSameBranch(get(/databases/$(database)/documents/schoolOutreach/$(schoolId)).data)))
          && request.resource.data.visitDate is string
          && request.resource.data.contactName is string
          && request.resource.data.contactRole is string;
        allow update, delete: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
