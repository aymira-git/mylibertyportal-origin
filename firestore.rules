rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function hasRole(role) {
      return signedIn() && userProfile().role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isManager() {
      return hasRole('manager');
    }

    function isStaff() {
      return signedIn() && userProfile().role in ['admin', 'manager', 'instructor', 'marketing', 'frontoffice', 'officeboy'];
    }

    function isFrontOffice() {
      return hasRole('frontoffice');
    }

    function roleOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function isTrackedShiftRole(r) {
      return r in ['instructor', 'frontoffice', 'marketing', 'officeboy', 'admin', 'manager'];
    }

    function isTrackedLeaveRole(r) {
      return r in ['instructor', 'frontoffice', 'marketing', 'officeboy', 'admin'];
    }

    function isInviteValid(inviteId) {
      let inv = get(/databases/$(database)/documents/invites/$(inviteId)).data;
      return inv.email == request.auth.token.email.lower()
          && inv.role == request.resource.data.role
          && (!('expiresAt' in inv) || inv.expiresAt > request.time.toMillis());
    }

    match /users/{userId} {
      allow read: if isAdmin()
        || isManager()
        || (isStaff() && resource.data.role in ['student', 'instructor'])
        || (signedIn() && userId == request.auth.uid);
      allow create: if isAdmin() 
        || (isFrontOffice() && request.resource.data.role == 'student')
        || (signedIn()
            && userId == request.auth.uid
            && request.resource.data.inviteId is string
            && isInviteValid(request.resource.data.inviteId));
      allow delete: if isAdmin() || (isFrontOffice() && resource.data.role == 'student');
      allow update: if isAdmin()
        || (isFrontOffice() && resource.data.role == 'student' && request.resource.data.role == 'student')
        || (signedIn()
          && userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'phone', 'dob', 'photoURL', 'nickname']));
    }

    match /invites/{inviteId} {
      // inviteId is the invite's unguessable token. Public signup can look
      // an invite up by its exact ID, but can never list/dump the collection.
      allow get: if true;
      allow list: if isAdmin() || isFrontOffice();

      // A newly-registered staff member may clear the one invite that
      // matches their own (just-verified) auth email; admins can cancel any.
      allow delete: if isAdmin()
        || (signedIn() && resource.data.email == request.auth.token.email);

      allow create: if isAdmin();
    }

    match /applications/{applicationId} {
      // Office and Admin handle admissions as their core function — approve
      // and reject update the record's status, while permanent delete is available
      // from the archive view.
      // Manager gets read-only visibility for dashboard stats — approving/
      // rejecting stays an Admin/Front Office job, not a Manager one.
      // Marketing gets read-only visibility too, for the lead-count widget
      // on their own dashboard — same reasoning, no approve/reject rights.
      allow read: if isAdmin() || isFrontOffice() || isManager() || hasRole('marketing');
      allow update, delete: if isAdmin() || isFrontOffice();
      allow create: if false;
    }

    match /classes/{classId} {
      allow read: if isStaff()
        || (signedIn() && resource.data.studentIds.hasAny([request.auth.uid]));
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isFrontOffice()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentIds', 'enrollments', 'updatedAt']));
    }

    match /todos/{todoId} {
      // All active staff can read directives to receive their assignments
      allow read: if isStaff();
      // Admins and Managers issue directives; Front Office can manage desk directives
      allow create, delete: if isAdmin() || isManager() || isFrontOffice();
      // Admins, Managers, and Front Office can update any directive field;
      // other staff can only toggle completion status and attribution
      allow update: if isAdmin() || isManager() || isFrontOffice()
        || (isStaff() && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['completed', 'completedAt', 'completedBy', 'completedByName', 'updatedAt']));
    }

    match /attendance/{attendanceId} {
      allow read: if isStaff();
      // Student scans: Admin (reception station), Front Office, and Instructor; scanned person must be a student
      allow create: if (isAdmin() || isFrontOffice() || hasRole('instructor'))
        && request.resource.data.userId is string
        && request.resource.data.timestamp is string
        && roleOf(request.resource.data.userId) == 'student';
      allow update, delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || isManager() || isFrontOffice();
      allow create, update, delete: if isAdmin() || isFrontOffice();
    }

    match /progressReports/{reportId} {
      allow read: if isAdmin()
        || isManager()
        || isFrontOffice()
        || (signedIn() && resource.data.instructorId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.instructorId == request.auth.uid
        && request.resource.data.studentId is string
        && request.resource.data.classId is string
        && get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.instructorId == request.auth.uid
        && get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.studentIds.hasAny([request.resource.data.studentId]);
      allow update, delete: if isAdmin() || isFrontOffice();
    }

    match /shifts/{shiftId} {
      allow read: if isAdmin()
        || isManager()
        || (signedIn() && resource.data.userId == request.auth.uid);
      // Staff scans: Admin only, for tracked roles only, new shifts start open
      allow create: if isAdmin()
        && request.resource.data.userId is string
        && request.resource.data.clockOut == null
        && isTrackedShiftRole(roleOf(request.resource.data.userId));
      // Deploy B: Shift updates and manual corrections are strictly Admin-only
      allow update, delete: if isAdmin();
    }

    match /shiftAuditEvents/{eventId} {
      allow read: if isAdmin() || isManager();
      allow create: if isAdmin()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.shiftId is string;
      allow update, delete: if false; // append-only immutable audit trail
    }

    match /corporateEvents/{eventId} {
      allow read: if isStaff();
      allow create: if (isAdmin() || isFrontOffice())
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.name is string
        && request.resource.data.eventDate is string
        && request.resource.data.audienceType in ['all', 'branch', 'role', 'division'];
      allow update: if (isAdmin() || isFrontOffice())
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false; // soft-cancel only
    }

    match /staffLeave/{leaveId} {
      allow read: if isAdmin()
        || isManager()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.status == 'approved'
        && isTrackedLeaveRole(roleOf(request.resource.data.userId));
      allow update, delete: if isAdmin();
    }

    match /materials/{materialId} {
      allow read: if signedIn()
        && resource.data.createdBy == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.createdBy == request.auth.uid;
    }

    match /errorLogs/{logId} {
      allow create: if request.resource.data.message is string
        && request.resource.data.timestamp is string;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /schoolOutreach/{schoolId} {
      // Read access is restricted to roles that have an operational need:
      // Admin (full access), Manager (oversight/reporting), Marketing (field work).
      // Instructor, Front Office, and Office Boy have no outreach business and are excluded.
      allow read: if isAdmin() || isManager() || hasRole('marketing');
      allow create: if (isAdmin() || isManager() || hasRole('marketing'))
        && request.resource.data.name is string
        && request.resource.data.lat is number
        && request.resource.data.lng is number;
      allow update: if (isAdmin() || isManager() || hasRole('marketing'))
        && (!('createdBy' in resource.data) || request.resource.data.createdBy == resource.data.createdBy)
        && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if isAdmin();

      match /visits/{visitId} {
        // Same role restriction as parent — only outreach-related roles may read visit records.
        allow read: if isAdmin() || isManager() || hasRole('marketing');
        allow create: if (isAdmin() || isManager() || hasRole('marketing'))
          && request.resource.data.visitDate is string
          && request.resource.data.contactName is string
          && request.resource.data.contactRole is string;
        allow update, delete: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
