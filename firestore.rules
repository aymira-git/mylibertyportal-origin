rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function isActiveUser() {
      return signedIn()
        && (!('status' in userProfile()) || (userProfile().status != 'resigned' && userProfile().status != 'terminated'));
    }

    function hasRole(role) {
      return signedIn() && isActiveUser() && userProfile().role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isManager() {
      return hasRole('manager') || hasRole('branch_manager');
    }

    function isStaff() {
      return signedIn() && isActiveUser() && userProfile().role in ['admin', 'manager', 'branch_manager', 'instructor', 'instructorleader', 'instructor_leader', 'marketing', 'frontoffice', 'opslead', 'ops_lead', 'frontofficelead', 'officeboy'];
    }

    function isFrontOffice() {
      return signedIn() && isActiveUser() && userProfile().role in ['frontoffice', 'opslead', 'ops_lead', 'frontofficelead'];
    }

    function isActiveProfile(profile) {
      return profile != null
        && (!('status' in profile) || (profile.status != 'resigned' && profile.status != 'terminated'));
    }

    function isFrontOfficeProfile(profile) {
      return signedIn()
        && isActiveProfile(profile)
        && profile.role in ['frontoffice', 'opslead', 'ops_lead', 'frontofficelead'];
    }

    function branchForProfile(profile) {
      return ('branchId' in profile)
        ? profile.branchId
        : (('branch' in profile)
          ? (
            profile.branch == 'Bone Bolango' ? 'bone_bolango' :
            profile.branch == 'Pohuwato' ? 'pohuwato' :
            profile.branch == 'Limboto' ? 'limboto' : 'kota_gorontalo'
          )
          : 'kota_gorontalo');
    }

    function isSameBranchForProfile(data, profile) {
      let branchId = branchForProfile(profile);
      return data != null && (
        ('branchId' in data && data.branchId == branchId)
        || (!('branchId' in data) && 'branch' in data && (
          (data.branch == 'Bone Bolango' && branchId == 'bone_bolango')
          || (data.branch == 'Pohuwato' && branchId == 'pohuwato')
          || (data.branch == 'Limboto' && branchId == 'limboto')
          || (data.branch == 'Cabang Utama' && branchId == 'kota_gorontalo')
          || (data.branch == 'Kota Gorontalo' && branchId == 'kota_gorontalo')
        ))
        || (!('branchId' in data) && !('branch' in data) && branchId == 'kota_gorontalo')
      );
    }

    function isFrontOfficeDivisionAllowed(data, profile) {
      let division = ('division' in profile) ? profile.division : null;
      return data != null && (
        division == 'all'
        || (division == 'kindergarten'
          ? ('division' in data && data.division == 'kindergarten')
          : (!('division' in data) || data.division != 'kindergarten'))
      );
    }

    function canFrontOfficeUpdateStudent(before, after) {
      let profile = userProfile();
      return isFrontOfficeProfile(profile)
        && before.role == 'student'
        && after.role == 'student'
        && isSameBranchForProfile(before, profile)
        && isSameBranchForProfile(after, profile)
        && isFrontOfficeDivisionAllowed(before, profile)
        && isFrontOfficeDivisionAllowed(after, profile)
        && (!('branchId' in before) || after.branchId == before.branchId)
        && after.diff(before).affectedKeys().hasOnly([
          'displayName', 'name', 'phone', 'dob', 'address', 'parentName', 'parentPhone',
          'emergencyContact', 'emergencyPhone', 'notes', 'placementTests', 'status',
          'statusUpdatedAt', 'statusUpdatedBy',
          'level', 'currentLevel', 'enrollmentDate',
          'updatedAt', 'photoURL', 'nickname', 'gender', 'nis', 'school', 'grade',
          'placeOfBirth', 'religion', 'programId', 'program', 'batchType', 'classType',
          'schoolOrJob', 'classOrSemester', 'joinedDate', 'fatherName', 'fatherJob',
          'fatherPhone', 'motherName', 'motherJob', 'motherPhone', 'referralSource',
          'rating', 'paymentPlan', 'paymentStatus', 'lastPaymentPeriod', 'lastPaymentDate',
          'lastPaymentAmount', 'lastPaymentMethod', 'paidUntil', 'branch', 'division'
        ]);
    }

    function canFrontOfficeUpdatePayment(before, after) {
      let profile = userProfile();
      return isFrontOfficeProfile(profile)
        && isSameBranchForProfile(before, profile)
        && isSameBranchForProfile(after, profile)
        && (!('branchId' in before) || after.branchId == before.branchId)
        && after.diff(before).affectedKeys()
          .hasOnly(['notes', 'approvalStatus', 'referenceNumber', 'updatedAt']);
    }

    function canCreatePayment(payment) {
      let profile = userProfile();
      let isAdminCaller = signedIn() && isActiveProfile(profile) && profile.role == 'admin';
      let student = get(/databases/$(database)/documents/users/$(payment.studentId)).data;
      return (isAdminCaller
          || (isFrontOfficeProfile(profile)
            && isSameBranchForProfile(payment, profile)
            && isFrontOfficeDivisionAllowed(payment, profile)))
        && payment.amount is number
        && payment.amount > 0
        && payment.studentId is string
        && student.role == 'student'
        && (isAdminCaller || isSameBranchForProfile(student, profile));
    }

    function userBranch() {
      return signedIn() && ('branchId' in userProfile())
        ? userProfile().branchId
        : (signedIn() && ('branch' in userProfile())
          ? (
            (userProfile().branch == 'Bone Bolango' ? 'bone_bolango' :
            userProfile().branch == 'Pohuwato' ? 'pohuwato' :
            userProfile().branch == 'Limboto' ? 'limboto' : 'kota_gorontalo')
          )
          : 'kota_gorontalo');
    }

    function isSameBranch(data) {
      return isAdmin() || (signedIn() && (
        (data != null && 'branchId' in data && data.branchId == userBranch()) ||
        (data != null && !('branchId' in data) && 'branch' in data && (
          (data.branch == 'Bone Bolango' && userBranch() == 'bone_bolango') ||
          (data.branch == 'Pohuwato' && userBranch() == 'pohuwato') ||
          (data.branch == 'Limboto' && userBranch() == 'limboto') ||
          (data.branch == 'Cabang Utama' && userBranch() == 'kota_gorontalo') ||
          (data.branch == 'Kota Gorontalo' && userBranch() == 'kota_gorontalo')
        )) ||
        (data != null && !('branchId' in data) && !('branch' in data) && userBranch() == 'kota_gorontalo')
      ));
    }

    // For `list` only: isSameBranch's no-branch-fields -> kota_gorontalo fallback
    // is unsound there. List rules are evaluated against a synthetic document
    // built from the query's where clauses, so a query with no branch filter
    // produces a fieldless synthetic doc that the fallback treats as Kota
    // Gorontalo — letting Kota Gorontalo staff list every branch's documents.
    // get/update/delete keep the lenient form so legacy branchless docs stay
    // readable/writable to Kota Gorontalo staff.
    function isSameBranchStrict(data) {
      return (data != null && 'branchId' in data && data.branchId == userBranch())
        || (data != null && !('branchId' in data) && 'branch' in data && (
          (data.branch == 'Bone Bolango' && userBranch() == 'bone_bolango') ||
          (data.branch == 'Pohuwato' && userBranch() == 'pohuwato') ||
          (data.branch == 'Limboto' && userBranch() == 'limboto') ||
          (data.branch == 'Cabang Utama' && userBranch() == 'kota_gorontalo') ||
          (data.branch == 'Kota Gorontalo' && userBranch() == 'kota_gorontalo')
        ));
    }

    // Division scope helpers for branch staff (manager & front office)
    function userDivision() {
      return signedIn() && ('division' in userProfile()) ? userProfile().division : null;
    }

    function isSameDivisionStrict(data) {
      return data != null && ('division' in data) && data.division == userDivision();
    }

    function isDivisionAllowedForBranchStaff(data) {
      return !(isManager() || isFrontOffice())
        || (userDivision() == 'all')
        || (userDivision() == 'kindergarten'
          ? (data != null && 'division' in data && data.division == 'kindergarten')
          : (!('division' in data) || data.division != 'kindergarten'));
    }

    function isDivisionAllowedForManager(data) {
      return isDivisionAllowedForBranchStaff(data);
    }

    function isApproverForDoc(data) {
      let targetRole = data != null && 'approverRole' in data ? data.approverRole : 'manager';
      let roleMatches = (targetRole == 'admin' && isAdmin())
        || (targetRole == 'manager' && isManager())
        || ((targetRole == 'instructor_leader' || targetRole == 'instructorleader') && (hasRole('instructorleader') || hasRole('instructor_leader')))
        || ((targetRole == 'ops_lead' || targetRole == 'opslead' || targetRole == 'frontoffice') && isFrontOffice());
      // Approval docs route by approverBranchId (see approvalGates.js); fall back
      // to the generic branch fields for legacy docs.
      let branchMatches = isAdmin() || (data != null && 'approverBranchId' in data
        ? data.approverBranchId == userBranch()
        : isSameBranch(data));
      return roleMatches && branchMatches;
    }

    function roleOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function isTrackedShiftRole(r) {
      return r in ['instructor', 'instructorleader', 'instructor_leader', 'frontoffice', 'opslead', 'ops_lead', 'frontofficelead', 'marketing', 'officeboy', 'admin', 'manager'];
    }

    function isTrackedLeaveRole(r) {
      return r in ['instructor', 'instructorleader', 'instructor_leader', 'frontoffice', 'opslead', 'ops_lead', 'frontofficelead', 'marketing', 'officeboy', 'admin'];
    }

    function isInviteValid(inviteId) {
      let inv = get(/databases/$(database)/documents/invites/$(inviteId)).data;
      return inv.email == request.auth.token.email.lower()
          && inv.role == request.resource.data.role
          && (!('expiresAt' in inv) || inv.expiresAt > request.time.toMillis())
          && (!('branchId' in inv) || request.resource.data.branchId == inv.branchId)
          && (!('division' in inv) || request.resource.data.division == inv.division);
    }

    function isApprovedShiftCorrection(shiftId, approvalId) {
      let approval = get(/databases/$(database)/documents/approvals/$(approvalId)).data;
      return approval.actionId == 'STAFF_SHIFT_SELF_CORRECTION'
        && approval.status == 'approved'
        && (!('applied' in approval) || approval.applied != true)
        && 'payload' in approval
        && approval.payload != null
        && approval.payload.shiftId == shiftId;
    }

    function shiftMatchesCorrectionPayload(approvalId, reqData, resData) {
      let payload = get(/databases/$(database)/documents/approvals/$(approvalId)).data.payload;
      return !('afterData' in payload) || payload.afterData == null
        || (
          (!('clockIn' in payload.afterData) ? reqData.clockIn == resData.clockIn : reqData.clockIn == payload.afterData.clockIn)
          && (!('clockOut' in payload.afterData) ? reqData.clockOut == resData.clockOut : reqData.clockOut == payload.afterData.clockOut)
        );
    }

    function classDoc(classId) {
      return get(/databases/$(database)/documents/classes/$(classId)).data;
    }

    function isAssignedToClass(classId) {
      let c = classDoc(classId);
      return c != null
        && signedIn()
        && (
          c.instructorId == request.auth.uid
          || ('substituteInstructorId' in c && c.substituteInstructorId == request.auth.uid)
        );
    }

    function canManageClassAttendance(classId) {
      let c = classDoc(classId);
      return c != null
        && (
          isAdmin()
          || (
            isFrontOffice()
            && isSameBranch(c)
          )
          || (
            (
              hasRole('instructor')
              || hasRole('instructorleader')
              || hasRole('instructor_leader')
            )
            && isAssignedToClass(classId)
          )
        );
    }

    function studentIsEnrolled(classId, studentId) {
      let c = classDoc(classId);
      // Firestore rules cannot safely inspect a nested field inside every
      // enrollment map. `studentIds` is the authorization roster and is
      // maintained alongside the richer `enrollments` display metadata.
      return c != null && ('studentIds' in c) && c.studentIds.hasAny([studentId]);
    }

    function validClassAttendanceIdentity(data) {
      return data.classId is string
        && data.studentId is string
        && data.attendanceDate is string
        && data.markedBy is string
        && data.markedBy == request.auth.uid;
    }

    function isParent() {
      return signedIn() && isActiveUser() && userProfile().role == 'parent';
    }

    function isParentOf(studentId) {
      return isParent()
        && ('childStudentIds' in userProfile())
        && userProfile().childStudentIds.hasAny([studentId])
        && exists(/databases/$(database)/documents/users/$(studentId))
        && get(/databases/$(database)/documents/users/$(studentId)).data.role == 'student'
        && isSameBranch(get(/databases/$(database)/documents/users/$(studentId)).data)
        && (!('status' in get(/databases/$(database)/documents/users/$(studentId)).data)
          || get(/databases/$(database)/documents/users/$(studentId)).data.status == 'active');
    }

    match /users/{userId} {
      allow get: if (signedIn() && userId == request.auth.uid)
        || isAdmin()
        || ((isManager() || isFrontOffice()) && isSameBranch(resource.data) && (resource.data.role == 'parent' || isDivisionAllowedForBranchStaff(resource.data)))
        || (isStaff() && resource.data.role in ['student', 'instructor', 'instructorleader', 'instructor_leader', 'parent'] && isSameBranch(resource.data) && (resource.data.role == 'parent' || isDivisionAllowedForBranchStaff(resource.data)))
        || (isParentOf(userId) && resource.data.role == 'student');
      allow list: if isAdmin()
        || (isManager() && isSameBranchStrict(resource.data) && (resource.data.role == 'parent' || isDivisionAllowedForBranchStaff(resource.data)))
        || (isStaff() && resource.data.role in ['student', 'instructor', 'instructorleader', 'instructor_leader', 'parent'] && isSameBranchStrict(resource.data) && (resource.data.role == 'parent' || isDivisionAllowedForBranchStaff(resource.data)));
      allow create: if isAdmin() 
        || (isFrontOffice() && request.resource.data.role in ['student', 'parent'] && isSameBranch(request.resource.data)
          && (request.resource.data.role != 'student' || isDivisionAllowedForBranchStaff(request.resource.data))
          && (request.resource.data.role != 'parent'
            || !('childStudentIds' in request.resource.data)
            || request.resource.data.childStudentIds.size() == 0))
        || (signedIn()
            && userId == request.auth.uid
            && request.resource.data.inviteId is string
            && isInviteValid(request.resource.data.inviteId)
            && request.resource.data.keys().hasOnly([
              'firstName', 'lastName', 'nickname', 'gender', 'displayName', 'email',
              'role', 'branch', 'branchId', 'division', 'status', 'phone', 'dob',
              'educationLevel', 'inviteId', 'createdAt', 'photoURL'
            ]));
      allow delete: if isAdmin() || (isFrontOffice() && resource.data.role in ['student', 'parent'] && isSameBranch(resource.data) && (resource.data.role != 'student' || isDivisionAllowedForBranchStaff(resource.data)));
      allow update: if isAdmin()
        || canFrontOfficeUpdateStudent(resource.data, request.resource.data)
        || (isFrontOffice()
          && resource.data.role == 'parent'
          && request.resource.data.role == 'parent'
          && isSameBranch(resource.data)
          && isSameBranch(request.resource.data)
          && (!('branchId' in resource.data) || request.resource.data.branchId == resource.data.branchId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'phone', 'updatedAt', 'status', 'branch']))
        || (signedIn()
          && userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'phone', 'dob', 'photoURL', 'nickname']));
    }

    match /invites/{inviteId} {
      // inviteId is the invite's unguessable token. Public signup can look
      // an invite up by its exact ID, but can never list/dump the collection.
      allow get: if true;
      allow list: if isAdmin() || (isFrontOffice() && isSameBranchStrict(resource.data));

      // A newly-registered staff member may clear the one invite that
      // matches their own (just-verified) auth email; admins can cancel any.
      allow delete: if isAdmin()
        || (signedIn() && resource.data.email == request.auth.token.email);

      allow create: if isAdmin();
    }

    match /applications/{applicationId} {
      allow get: if isAdmin() || ((isFrontOffice() || isManager() || hasRole('marketing')) && isSameBranch(resource.data) && isDivisionAllowedForManager(resource.data));
      allow list: if isAdmin() || ((isFrontOffice() || isManager() || hasRole('marketing')) && isSameBranchStrict(resource.data) && isDivisionAllowedForManager(resource.data));
      allow update: if isAdmin() || (isFrontOffice() && isSameBranch(resource.data) && isSameBranch(request.resource.data) && isDivisionAllowedForBranchStaff(resource.data) && isDivisionAllowedForBranchStaff(request.resource.data) && (!('branchId' in resource.data) || request.resource.data.branchId == resource.data.branchId));
      allow delete: if isAdmin() || (isFrontOffice() && isSameBranch(resource.data) && isDivisionAllowedForBranchStaff(resource.data));
      allow create: if false;
    }

    match /classes/{classId} {
      allow get: if isAdmin()
        || (isStaff() && isSameBranch(resource.data) && isDivisionAllowedForManager(resource.data))
        || (isStaff() && (
            resource.data.instructorId == request.auth.uid
            || ('substituteInstructorId' in resource.data && resource.data.substituteInstructorId == request.auth.uid)
          ))
        || (signedIn() && ('studentIds' in resource.data) && resource.data.studentIds.hasAny([request.auth.uid]))
        || (isParent() && isSameBranch(resource.data) && ('childStudentIds' in userProfile()) && ('studentIds' in resource.data) && resource.data.studentIds.hasAny(userProfile().childStudentIds));
      allow list: if isAdmin()
        || (isStaff() && isSameBranchStrict(resource.data) && isDivisionAllowedForManager(resource.data))
        || (isStaff() && (
            resource.data.instructorId == request.auth.uid
            || ('substituteInstructorId' in resource.data && resource.data.substituteInstructorId == request.auth.uid)
          ))
        || (signedIn() && ('studentIds' in resource.data) && resource.data.studentIds.hasAny([request.auth.uid]))
        || (isParent() && isSameBranchStrict(resource.data) && ('childStudentIds' in userProfile()) && ('studentIds' in resource.data) && resource.data.studentIds.hasAny(userProfile().childStudentIds));
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isFrontOffice()
          && isSameBranch(resource.data)
          && isSameBranch(request.resource.data)
          && isDivisionAllowedForBranchStaff(resource.data)
          && isDivisionAllowedForBranchStaff(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentIds', 'enrollments', 'updatedAt'])
          && (!('capacity' in resource.data) || request.resource.data.studentIds.size() <= resource.data.capacity)
          && (!('maxStudents' in resource.data) || request.resource.data.studentIds.size() <= resource.data.maxStudents));
    }

    match /todos/{todoId} {
      // Branch-lock directives by default. Admin has cross-branch access.
      // Explicitly academy-wide directives (branch == 'all' or branchId == 'all') are readable by all staff.
      allow get: if isAdmin()
        || (isStaff() && (
          isSameBranch(resource.data)
          || (('branch' in resource.data) && (resource.data.branch == 'all' || resource.data.branch == 'All'))
          || (('branchId' in resource.data) && resource.data.branchId == 'all')
        ));
      allow list: if isAdmin()
        || (isStaff() && (
          isSameBranchStrict(resource.data)
          || (('branchId' in resource.data) && resource.data.branchId == 'all')
          || (('branch' in resource.data) && (resource.data.branch == 'all' || resource.data.branch == 'All'))
        ));
      // Admins and Managers issue directives; Front Office can manage desk directives in their branch
      allow create, delete: if isAdmin()
        || ((isManager() || isFrontOffice()) && isSameBranch(request.resource.data));
      // Admins, Managers, and Front Office can update any directive field;
      // other staff can only toggle completion status and attribution
      allow update: if isAdmin()
        || ((isManager() || isFrontOffice()) && isSameBranch(resource.data) && isSameBranch(request.resource.data))
        || (isStaff()
            && (
              isSameBranch(resource.data)
              || (('branch' in resource.data) && (resource.data.branch == 'all' || resource.data.branch == 'All'))
              || (('branchId' in resource.data) && resource.data.branchId == 'all')
            )
            && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['completed', 'completedAt', 'completedBy', 'completedByName', 'updatedAt']));
    }

    match /attendance/{attendanceId} {
      // Branch-lock attendance by default. Admin has cross-branch access.
      allow get: if isAdmin()
        || (isStaff() && isSameBranch(resource.data) && isDivisionAllowedForBranchStaff(resource.data));
      allow list: if isAdmin()
        || (isStaff() && isSameBranchStrict(resource.data) && isDivisionAllowedForBranchStaff(resource.data));
      // Student scans: Admin (reception station), Front Office, Instructor, and Instructor Leader; scanned person must be a student
      allow create: if (isAdmin() || isFrontOffice() || hasRole('instructor') || hasRole('instructorleader') || hasRole('instructor_leader'))
        && isSameBranch(request.resource.data)
        && isDivisionAllowedForBranchStaff(request.resource.data)
        && request.resource.data.userId is string
        && request.resource.data.timestamp is string
        && roleOf(request.resource.data.userId) == 'student'
        && isSameBranch(get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data);
      // Double-scan idempotency: allow Front Office and Instructors to update existing day scan as long as student identity is preserved
      allow update: if isAdmin()
        || ((isFrontOffice() || hasRole('instructor') || hasRole('instructorleader') || hasRole('instructor_leader'))
          && isSameBranch(resource.data)
          && isSameBranch(request.resource.data)
          && isDivisionAllowedForBranchStaff(resource.data)
          && isDivisionAllowedForBranchStaff(request.resource.data)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /corporateEvents/{eventId} {
      // Corporate events represent internal school calendar items (meetings, trainings, closures).
      // All authenticated staff need read access so Kiosk and Front Office dashboards can query
      // upcoming events without Firestore rejecting collection queries.
      // Students and parents cannot read corporate events.
      allow read: if isStaff();
      allow create: if (isAdmin() || isManager() || isFrontOffice())
        && request.resource.data.name is string
        && request.resource.data.eventDate is string
        && request.resource.data.audienceType in ['all', 'branch', 'role', 'division']
        && (isAdmin() || (
          request.resource.data.audienceType != 'branch'
          || request.resource.data.audienceValue == userBranch()
          || (request.resource.data.audienceValue == 'Kota Gorontalo' && userBranch() == 'kota_gorontalo')
          || (request.resource.data.audienceValue == 'Bone Bolango' && userBranch() == 'bone_bolango')
          || (request.resource.data.audienceValue == 'Pohuwato' && userBranch() == 'pohuwato')
          || (request.resource.data.audienceValue == 'Limboto' && userBranch() == 'limboto')
        ));
      allow update: if isAdmin()
        || ((isManager() || isFrontOffice())
          && isSameBranch(resource.data)
          && (
            request.resource.data.audienceType != 'branch'
            || request.resource.data.audienceValue == userBranch()
            || (request.resource.data.audienceValue == 'Kota Gorontalo' && userBranch() == 'kota_gorontalo')
            || (request.resource.data.audienceValue == 'Bone Bolango' && userBranch() == 'bone_bolango')
            || (request.resource.data.audienceValue == 'Pohuwato' && userBranch() == 'pohuwato')
            || (request.resource.data.audienceValue == 'Limboto' && userBranch() == 'limboto')
          ));
      allow delete: if isAdmin() || ((isManager() || isFrontOffice()) && isSameBranch(resource.data));
    }

    match /classAttendance/{attendanceId} {
      allow read: if
        isAdmin()
        || (
          (isManager() || isFrontOffice())
          && isSameBranch(classDoc(resource.data.classId))
          && isDivisionAllowedForBranchStaff(classDoc(resource.data.classId))
        )
        || (
          (
            hasRole('instructor')
            || hasRole('instructorleader')
            || hasRole('instructor_leader')
          )
          && isAssignedToClass(resource.data.classId)
        )
        || (
          signedIn()
          && resource.data.studentId == request.auth.uid
        )
        || (
          signedIn()
          && isParentOf(resource.data.studentId)
        );

      // First attendance creation only. Enforce deterministic document ID {classId}_{studentId}_{attendanceDate}.
      allow create: if
        attendanceId == request.resource.data.classId + '_' + request.resource.data.studentId + '_' + request.resource.data.attendanceDate
        && canManageClassAttendance(request.resource.data.classId)
        && validClassAttendanceIdentity(request.resource.data)
        && studentIsEnrolled(
          request.resource.data.classId,
          request.resource.data.studentId
        )
        && request.resource.data.status in ['PRESENT', 'ABSENT', 'LATE', 'EXCUSED']
        && request.resource.data.method in ['SCAN', 'MANUAL', 'CLOSE_OUT'];

      // Existing records must not be overwritten by scan.
      allow update: if
        canManageClassAttendance(resource.data.classId)
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.attendanceDate == resource.data.attendanceDate
        && validClassAttendanceIdentity(request.resource.data)
        && request.resource.data.method == 'MANUAL'
        && request.resource.data.status in ['PRESENT', 'ABSENT', 'LATE', 'EXCUSED']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'note', 'method', 'markedBy', 'markedByName', 'markedAt', 'updatedAt']);

      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow get: if isAdmin()
        || ((isManager() || isFrontOffice()) && isSameBranch(resource.data) && isDivisionAllowedForBranchStaff(resource.data))
        || (signedIn() && (resource.data.studentId == request.auth.uid || isParentOf(resource.data.studentId)));
      allow list: if isAdmin()
        || ((isManager() || isFrontOffice()) && isSameBranchStrict(resource.data) && isDivisionAllowedForBranchStaff(resource.data));
      allow create: if canCreatePayment(request.resource.data);
      allow update: if isAdmin() || canFrontOfficeUpdatePayment(resource.data, request.resource.data);
      allow delete: if isAdmin();
    }

    match /deskInquiries/{inquiryId} {
      allow get: if isAdmin() || ((isManager() || isFrontOffice() || isStaff()) && isSameBranch(resource.data) && isDivisionAllowedForManager(resource.data));
      allow list: if isAdmin() || ((isManager() || isFrontOffice() || isStaff()) && isSameBranchStrict(resource.data) && isDivisionAllowedForManager(resource.data));
      allow create: if isAdmin() || ((isManager() || isFrontOffice() || isStaff()) && isSameBranch(request.resource.data) && isDivisionAllowedForManager(request.resource.data));
      allow update: if isAdmin() || ((isManager() || isFrontOffice() || isStaff()) && isSameBranch(resource.data) && isSameBranch(request.resource.data) && (!('branchId' in resource.data) || request.resource.data.branchId == resource.data.branchId) && isDivisionAllowedForManager(resource.data) && isDivisionAllowedForManager(request.resource.data));
      allow delete: if isAdmin() || ((isManager() || isFrontOffice()) && isSameBranch(resource.data) && isDivisionAllowedForManager(resource.data));
    }

    match /approvals/{approvalId} {
      allow read: if isAdmin()
        || isApproverForDoc(resource.data)
        || (signedIn() && resource.data.requestedByUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.requestedByUid == request.auth.uid
        && (!('status' in request.resource.data) || request.resource.data.status == 'pending')
        && (
          isStaff()
          || (
            request.resource.data.actionId == 'NEW_STAFF_ACCOUNT'
            && 'payload' in request.resource.data
            && request.resource.data.payload.uid == request.auth.uid
          )
        );
      allow update: if isAdmin()
        || (isApproverForDoc(resource.data)
          && request.auth.uid != resource.data.requestedByUid
          && request.resource.data.requestedByUid == resource.data.requestedByUid
          && (
            (request.resource.data.status in ['approved', 'rejected']
              && request.resource.data.decidedByUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'decidedBy', 'decidedByUid', 'decidedAt', 'decisionNotes', 'rejectionReason', 'updatedAt']))
            ||
            (resource.data.status == 'approved'
              && request.resource.data.status == resource.data.status
              && request.resource.data.applied == true
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['applied', 'appliedAt', 'appliedByUid', 'updatedAt']))
          ));
      allow delete: if isAdmin();
    }

    match /progressReports/{reportId} {
      allow get: if isAdmin()
        || ((isManager() || isFrontOffice()) && isSameBranch(resource.data) && isDivisionAllowedForManager(resource.data))
        || (signedIn() && resource.data.instructorId == request.auth.uid)
        || (isParentOf(resource.data.studentId));
      allow list: if isAdmin()
        || ((isManager() || isFrontOffice()) && isSameBranchStrict(resource.data) && isDivisionAllowedForManager(resource.data))
        || (signedIn() && resource.data.instructorId == request.auth.uid)
        || (isParentOf(resource.data.studentId));
      allow create: if signedIn()
        && request.resource.data.instructorId == request.auth.uid
        && request.resource.data.studentId is string
        && request.resource.data.classId is string
        && (get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.instructorId == request.auth.uid
          || (('substituteInstructorId' in get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data)
            && get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.substituteInstructorId == request.auth.uid))
        && get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.studentIds.hasAny([request.resource.data.studentId]);
      allow update, delete: if isAdmin() || ((isManager() || isFrontOffice()) && isSameBranch(resource.data) && isDivisionAllowedForManager(resource.data));
    }

    match /shifts/{shiftId} {
      allow get: if isAdmin()
        || ((isManager() || isFrontOffice()) && isSameBranch(resource.data) && isDivisionAllowedForBranchStaff(resource.data))
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin()
        || ((isManager() || isFrontOffice()) && isSameBranchStrict(resource.data) && isDivisionAllowedForBranchStaff(resource.data))
        || (signedIn() && resource.data.userId == request.auth.uid);
      // Staff scans: Admin and Front Office (reception kiosk station), for tracked roles only, new shifts start open
      allow create: if (isAdmin() || (isFrontOffice() && isSameBranch(request.resource.data) && isDivisionAllowedForBranchStaff(request.resource.data)))
        && request.resource.data.userId is string
        && request.resource.data.userId.size() > 0
        && request.resource.data.clockIn is string
        && request.resource.data.clockIn.size() > 0
        && request.resource.data.clockOut == null
        && isTrackedShiftRole(roleOf(request.resource.data.userId))
        && isSameBranch(get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data);
      // Shift clock-out and updates: Admin or Front Office (kiosk clock-out)
      allow update: if isAdmin()
        || (isFrontOffice()
          && isSameBranch(resource.data)
          && resource.data.clockOut == null
          && request.resource.data.clockOut is string
          && request.resource.data.userId == resource.data.userId
          && (!('branch' in resource.data) || request.resource.data.branch == resource.data.branch)
          && (!('branchId' in resource.data) || request.resource.data.branchId == resource.data.branchId)
          && request.resource.data.clockIn == resource.data.clockIn
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['clockOut', 'updatedAt', 'cashReconciliation', 'notes', 'status', 'verifiedBy', 'verifiedAt', 'autoClosed']))
        // Approved shift self-corrections: Front Office / Manager may only apply a correction
        // already approved via the maker-checker approvals collection (dual-control enforced by rules).
        || ((isFrontOffice() || isManager())
          && isSameBranch(resource.data)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.appliedFromApproval is string
          && isApprovedShiftCorrection(shiftId, request.resource.data.appliedFromApproval)
          && shiftMatchesCorrectionPayload(request.resource.data.appliedFromApproval, request.resource.data, resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['clockIn', 'clockOut', 'corrected', 'reviewStatus', 'appliedFromApproval']))
        // Front Office and Manager can mark a completed/closed shift as reviewed
        || ((isFrontOffice() || isManager())
          && isSameBranch(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewStatus']));
      allow delete: if isAdmin();
    }

    match /shiftAuditEvents/{eventId} {
      allow read: if isAdmin() || (isManager() && isSameBranchStrict(resource.data));
      allow create: if (isAdmin()
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.shiftId is string)
        || ((isFrontOffice() || isManager())
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.shiftId is string
          && request.resource.data.action == 'manual_adjustment'
          && request.resource.data.appliedFromApproval is string
          && isApprovedShiftCorrection(request.resource.data.shiftId, request.resource.data.appliedFromApproval));
      allow update, delete: if false; // append-only immutable audit trail
    }

    match /staffLeave/{leaveId} {
      allow get: if isAdmin()
        || (isManager() && isSameBranch(resource.data))
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin()
        || (isManager() && isSameBranchStrict(resource.data))
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.status == 'approved'
        && isTrackedLeaveRole(roleOf(request.resource.data.userId));
      allow update, delete: if isAdmin();
    }

    match /materials/{materialId} {
      allow read: if signedIn()
        && resource.data.createdBy == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.createdBy == request.auth.uid;
    }

    match /errorLogs/{logId} {
      allow create: if signedIn()
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000
        && request.resource.data.timestamp is string
        && (!('stack' in request.resource.data) || (request.resource.data.stack is string && request.resource.data.stack.size() <= 8000))
        && (!('url' in request.resource.data) || (request.resource.data.url is string && request.resource.data.url.size() <= 1000));
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /schoolOutreach/{schoolId} {
      // Read access is restricted to roles that have an operational need:
      // Admin (full access), Manager (oversight/reporting), Marketing (field work).
      // Instructor, Front Office, and Office Boy have no outreach business and are excluded.
      allow get: if isAdmin() || ((isManager() || hasRole('marketing')) && isSameBranch(resource.data));
      allow list: if isAdmin() || ((isManager() || hasRole('marketing')) && isSameBranchStrict(resource.data));
      allow create: if (isAdmin() || ((isManager() || hasRole('marketing')) && isSameBranch(request.resource.data)))
        && request.resource.data.name is string
        && request.resource.data.lat is number
        && request.resource.data.lng is number;
      allow update: if (isAdmin() || ((isManager() || hasRole('marketing')) && isSameBranch(resource.data) && isSameBranch(request.resource.data)))
        && (!('createdBy' in resource.data) || request.resource.data.createdBy == resource.data.createdBy)
        && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if isAdmin();

      match /visits/{visitId} {
        // Enforce strict branch check so visits are consistently isolated per branch across direct and collectionGroup queries
        allow read: if isAdmin()
          || ((isManager() || hasRole('marketing')) && isSameBranchStrict(resource.data));
        allow create: if (isAdmin() || ((isManager() || hasRole('marketing'))
            && isSameBranchStrict(request.resource.data)
            && isSameBranch(get(/databases/$(database)/documents/schoolOutreach/$(schoolId)).data)))
          && request.resource.data.visitDate is string
          && request.resource.data.contactName is string
          && request.resource.data.contactRole is string
          && request.resource.data.branchId is string
          && request.resource.data.branch is string
          && request.resource.data.source == 'schoolOutreach';
        allow update, delete: if isAdmin();
      }
    }

    match /{path=**}/visits/{visitId} {
      // Collection-group query matcher for outreach visits across schools
      allow read: if isAdmin()
        || ((isManager() || hasRole('marketing')) && isSameBranchStrict(resource.data));
      allow create: if (isAdmin()
          || ((isManager() || hasRole('marketing')) && isSameBranchStrict(request.resource.data)))
        && request.resource.data.visitDate is string
        && request.resource.data.contactName is string
        && request.resource.data.contactRole is string
        && request.resource.data.branchId is string
        && request.resource.data.branch is string
        && request.resource.data.source == 'schoolOutreach';
      allow update, delete: if isAdmin();
    }

    match /kioskDevices/{deviceId} {
      allow get: if isAdmin()
        || ((isFrontOffice() || isManager()) && isSameBranch(resource.data));
      allow list: if isAdmin()
        || ((isFrontOffice() || isManager()) && isSameBranchStrict(resource.data));
      allow write: if false; // Provisioning and revocation managed server-side
    }

    match /kioskChallenges/{deviceId} {
      allow read, write: if false; // Ephemeral challenge nonces strictly managed server-side
    }

    match /kioskAuditEvents/{eventId} {
      allow read: if isAdmin() || (isManager() && isSameBranchStrict(resource.data));
      allow write: if false; // Append-only audit events created server-side
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
